# Copy to .env (git-ignored). Never commit real values.
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://city:city@localhost:5432/city
REDIS_URL=redis://localhost:6379
JWT_SIGNING_KEY=           # 32+ random bytes, base64
OWNER_EMAIL=               # bootstrap owner identity (D-013)
WEBAUTHN_RP_ID=localhost
DEMO_MODE=0                # 1 enables FixturePlaceSource + labeled demo data

# Providers (leave blank to use deterministic fakes)
GOOGLE_MAPS_SERVER_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
EMAIL_PROVIDER=            # e.g. resend | postmark | none
EMAIL_API_KEY=
EMAIL_FROM=

# Client-restricted keys (safe to ship only when platform-restricted)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_MAPS_WEB_KEY=

# ---- API runtime (apps/api) ----
PORT=8080
AUDIO_DIR=./data/audio
BUILD_SHA=dev
CORS_ORIGINS=http://localhost:3000
WEBAUTHN_ORIGIN=http://localhost:3000
WIKIMEDIA_CONTACT=            # contact for the Wikimedia User-Agent policy (email or URL)
REALTIME_MAX_SECONDS=300
REALTIME_IDLE_TIMEOUT_S=20

# ---- Provider selection (ordered, comma-separated; a provider is used only if its key is set) ----
STORY_PROVIDERS=openai,gemini,anthropic
INTENT_PROVIDERS=openai,gemini,anthropic
TTS_PROVIDERS=openai,gemini
STT_PROVIDERS=openai,gemini
REALTIME_PROVIDERS=openai,gemini
PLACES_PROVIDERS=wikimedia
KNOWLEDGE_PROVIDERS=wikimedia
NEARBY_PROVIDERS=google_places

# ---- Model ids (provisional; verify with `pnpm bench:providers`, which checks the provider model lists) ----
OPENAI_STORY_MODEL=gpt-6-luna
OPENAI_INTENT_MODEL=gpt-6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REASONING_EFFORT=
GEMINI_STORY_MODEL=gemini-3.1-flash-lite
GEMINI_INTENT_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_LIVE_MODEL=gemini-3.8-live
ANTHROPIC_STORY_MODEL=claude-haiku-4-5

# ---- docker-compose (deploy) ----
APP_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=
