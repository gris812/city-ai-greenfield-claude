# Copy to .env (git-ignored). Never commit real values.
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://city:city@localhost:5432/city
REDIS_URL=redis://localhost:6379
JWT_SIGNING_KEY=           # 32+ random bytes, base64
OWNER_EMAIL=               # bootstrap owner identity (D-013)
WEBAUTHN_RP_ID=localhost
DEMO_MODE=0                # 1 enables FixturePlaceSource + labeled demo data

# Providers (leave blank to use deterministic fakes)
GOOGLE_MAPS_SERVER_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
EMAIL_PROVIDER=            # e.g. resend | postmark | none
EMAIL_API_KEY=
EMAIL_FROM=

# Client-restricted keys (safe to ship only when platform-restricted)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_MAPS_WEB_KEY=
