# Copy to apps/mobile/.env for local dev builds. For EAS builds set these in eas.json `env`
# or as EAS environment variables (`eas env:create`). None of these are secrets: they are
# compiled into the app. Restrict the Maps keys in Google Cloud (see docs/MOBILE.md).

# Telvey API base URL. Unset or *.example → the app runs in labelled offline demo mode.
EXPO_PUBLIC_API_BASE_URL=

# Maps SDK for Android key, restricted to package com.telvey.app(.preview|.dev) + signing SHA-1.
# Unset → a labelled schematic map is shown on Android instead of Google Maps.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Optional Maps SDK for iOS key (restricted to the bundle id). Unset → Apple Maps on iOS.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

# Identity (defaults shown). Variant suffixes .dev / .preview are added automatically.
APP_BUNDLE_ID=com.telvey.app
APP_ANDROID_PACKAGE=com.telvey.app
APP_VARIANT=development

# Written after `eas init` (see docs/MOBILE.md).
EXPO_OWNER=
EAS_PROJECT_ID=
