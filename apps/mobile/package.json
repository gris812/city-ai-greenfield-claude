{
  "name": "@city/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Telvey native app (Expo dev-client + expo-router): sensor, renderer and audio player for the server-side companion (D-002, D-016).",
  "main": "index.ts",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "start": "node scripts/prepare-assets.mjs && expo start --dev-client",
    "android": "node scripts/prepare-assets.mjs && expo run:android",
    "ios": "node scripts/prepare-assets.mjs && expo run:ios",
    "typecheck": "node scripts/prepare-assets.mjs && tsc --noEmit -p .",
    "test": "node scripts/prepare-assets.mjs && vitest run",
    "config": "expo config --type public",
    "export:android": "node scripts/prepare-assets.mjs && expo export --platform android --output-dir dist/android",
    "export:ios": "node scripts/prepare-assets.mjs && expo export --platform ios --output-dir dist/ios",
    "doctor": "expo-doctor",
    "eas-build-post-install": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@city/client": "workspace:*",
    "@city/core": "workspace:*",
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "57.1.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
