{
  "name": "@city/web",
  "version": "0.1.0",
  "private": true,
  "description": "Telvey public website, WebApp/PWA (/app) and admin console (/admin) \u2014 one Next.js app, three route groups (D-001).",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "node scripts/prepare-assets.mjs && tsc --noEmit -p .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@city/client": "workspace:*",
    "@city/core": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.26",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.6.0"
  }
