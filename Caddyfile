# TLS termination + reverse proxy (D-015). Domains come from env (docker-compose).
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip
	# Immutable content-addressed audio can be cached by the edge/browser.
	@audio path /v1/audio/*
	header @audio Cache-Control "public, max-age=31536000, immutable"
	# WebSocket upgrade is handled transparently by reverse_proxy.
	reverse_proxy api:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
					replace code REDACTED
				}
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
}
